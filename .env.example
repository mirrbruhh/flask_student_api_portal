# MongoDB Atlas connection string
# Replace username, password, and cluster address with your own
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Flask secret key for session security
# Generate a strong key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here

# Admin API Key to protect sensitive CRUD endpoints (PUT / DELETE)
# Must be passed in the 'x-api-key' header of the request.
# For local testing, a simple password like 'admin123' is fine.
# For production on Render, generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_API_KEY=your-admin-api-key-here

# Flask debug mode: 1 for local development, 0 for production
FLASK_DEBUG=0

# Host binding: 0.0.0.0 for Render, 127.0.0.1 for local
FLASK_HOST=0.0.0.0

# Comma-separated list of words to block as profanity
# Each word in the list will be checked in user submissions
PROFANITY_LIST=word1,word2,word3,....